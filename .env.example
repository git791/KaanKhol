# =============================================================================
# KaanKhol — Environment Variables Reference
# =============================================================================
# HOW TO USE THIS FILE
# --------------------
# 1. Copy this file to TWO places and fill in real values:
#
#    a) apps/edge/.dev.vars          ← Cloudflare Worker local dev (Hono)
#       (Wrangler reads .dev.vars automatically; DO NOT prefix with VITE_)
#
#    b) apps/web/.env.local          ← Vite frontend local dev
#       (Only VITE_ prefixed variables are exposed to the browser)
#
# 2. For production:
#    - Worker secrets  → run: wrangler secret put <KEY_NAME>  (one per key)
#    - Pages env vars  → Cloudflare Dashboard > Pages > Settings > Environment variables
#
# 3. NEVER commit either .dev.vars or .env.local to git.
#    Both are already listed in .gitignore.
#
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 1 — GNANI API  (server-side ONLY — Worker / .dev.vars)
# ─────────────────────────────────────────────────────────────────────────────
# Source: https://docs.gnani.ai  |  https://github.com/gnani-ai
#
# STEP 1: Create a free account at https://gnani.ai
# STEP 2: Navigate to your dashboard → API Keys → Create Key
# STEP 3: Copy the Key ID (not the secret token) into the value below.
#
# IMPORTANT: This key MUST stay server-side.
#   - Put it in apps/edge/.dev.vars for local dev
#   - Run `wrangler secret put GNANI_API_KEY_ID` for production
#   - Never put it in any VITE_ variable or in the browser bundle
#
# VERIFY ON DAY 1 (record answers in docs/TECHNICAL.md §12):
#   - What is the STT credit cost per call?
#   - What is the TTS credit cost per call?
#   - What is the total free credit quota?
#   - Confirm one-language-per-call and 60 s audio limit
#   - Confirm Timbre v2.5 endpoint URL and voice IDs for hi-IN and your regional pick
#
GNANI_API_KEY_ID=


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 2 — GOOGLE GEMINI API  (server-side ONLY — Worker / .dev.vars)
# ─────────────────────────────────────────────────────────────────────────────
# Used for: LLM fallback field extraction when regex misses fields.
# Model used: Gemini Flash (free tier) or Gemini Flash-Lite.
# Only synthetic/self-recorded transcripts are ever sent — never real audio.
#
# STEP 1: Go to https://aistudio.google.com/app/apikey
# STEP 2: Create a free API key (no card required for free tier)
# STEP 3: Check your actual RPD (requests per day) limit in the AI Studio dashboard
#         and record it in docs/TECHNICAL.md §12
#
# WARNING: Gemini free-tier prompts may be used for model training.
#          Send ONLY synthetic transcripts — never real passenger audio.
#
GEMINI_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 3 — CLOUDFLARE  (used in wrangler.toml — not a secret)
# ─────────────────────────────────────────────────────────────────────────────
# Source: https://dash.cloudflare.com → My Profile → API Tokens
#
# STEP 1: Create a free Cloudflare account at https://dash.cloudflare.com
# STEP 2: Go to: Workers & Pages → Overview → "Create application"
# STEP 3: Find your Account ID in the right sidebar of the Workers dashboard
# STEP 4: Create a D1 database:
#         Run: wrangler d1 create kaankhol
#         Copy the database_id it prints into apps/edge/wrangler.toml
#
# These values go into wrangler.toml, NOT into secrets.
# They are NOT sensitive (they are your account identifiers, not auth tokens).
#
CLOUDFLARE_ACCOUNT_ID=
# The D1 database_id from: wrangler d1 create kaankhol
CLOUDFLARE_D1_DATABASE_ID=


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 4 — FRONTEND (Vite — apps/web/.env.local only)
# ─────────────────────────────────────────────────────────────────────────────
# This is the only variable that goes in the browser bundle.
# It is the PUBLIC URL of your deployed Cloudflare Worker.
# It contains NO secrets.
#
# Local dev:  leave as http://localhost:8787  (default wrangler dev port)
# Production: set to your Worker's subdomain after `wrangler deploy`
#             e.g. https://kaankhol-edge.<your-subdomain>.workers.dev
#
VITE_WORKER_URL=http://localhost:8787


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 5 — OPTIONAL: Regional language default
# ─────────────────────────────────────────────────────────────────────────────
# The app auto-detects from navigator.language, but you can override for dev.
# Supported Gnani language codes (verify full list at docs.gnani.ai):
#   hi-IN  Hindi
#   en-IN  English (India)
#   ta-IN  Tamil
#   te-IN  Telugu
#   kn-IN  Kannada
#   ml-IN  Malayalam
#   bn-IN  Bengali
#   mr-IN  Marathi
#   gu-IN  Gujarati
#   pa-IN  Punjabi
#
# This is a build-time default only — users can change it in the UI.
# Put in apps/web/.env.local (VITE_ prefix so Vite exposes it).
#
VITE_DEFAULT_REGIONAL_LANG=


# =============================================================================
# FILE PLACEMENT SUMMARY
# =============================================================================
#
# Variable                    | apps/edge/.dev.vars | apps/web/.env.local | wrangler.toml
# ----------------------------|---------------------|---------------------|---------------
# GNANI_API_KEY_ID            |         YES         |         NO          |      NO
# GEMINI_API_KEY              |         YES         |         NO          |      NO
# CLOUDFLARE_ACCOUNT_ID       |         NO          |         NO          |     YES
# CLOUDFLARE_D1_DATABASE_ID   |         NO          |         NO          |     YES
# VITE_WORKER_URL             |         NO          |        YES          |      NO
# VITE_DEFAULT_REGIONAL_LANG  |         NO          |        YES          |      NO
#
# =============================================================================
